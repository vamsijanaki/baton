// Cloudflare Workers deploy for the website in site/ (no build step).
// worker/index.js only handles /assets/video/* (byte ranges for Safari); everything else is static.
{
  "name": "baton",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/video/*"]
  }
}
